<?xml version="1.0" encoding="utf-8"?>
<!-- Android Auto Backup / device transfer rules for API 31+. Same exclusion as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups/" />
    </device-transfer>
</data-extraction-rules>
