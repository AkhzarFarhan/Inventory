          'unitPricePaise', 'unitSellPaise', 'unitSellingPricePaise',
          'discountPaise', 'gstRateBps', 'taxRatePercent', 'taxRate',
          'taxPaise', 'lineTaxPaise',
          'lineCostPaise', 'lineTotalPaise', 'lineProfitPaise',
          'isReturned', 'isDeleted',
          'createdBy', 'createdByUid', 'updatedBy', 'updatedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().size() >= 2 &&
        isValidOptionalIdMatch('id', lineId) &&
        isValidOptionalShopIdField(shopId) &&
        validStringLength('invoiceId', 1, 128) &&
        isValidOptionalString('productId', 0, 128) &&
        isValidOptionalString('skuId', 0, 128) &&
        isValidOptionalString('itemId', 0, 128) &&
        isValidOptionalString('variantId', 0, 128) &&
        isValidOptionalString('itemNameSnapshot', 0, 200) &&
        isValidOptionalString('productNameSnapshot', 0, 200) &&
        isValidOptionalString('skuLabelSnapshot', 0, 200) &&
        isValidOptionalString('variantSummarySnapshot', 0, 200) &&
        isValidOptionalString('hsnCode', 0, 32) &&
        isValidOptionalString('hsnSnapshot', 0, 32) &&
        isValidOptionalString('unit', 1, 40) &&
        isValidOptionalString('unitSnapshot', 1, 40) &&
        (
          !('quantity' in request.resource.data) ||
          (request.resource.data.quantity is number &&
            request.resource.data.quantity > 0 &&
            request.resource.data.quantity <= 100000000)
        ) &&
        isValidOptionalInt('qtyMilliUnits', 1, 100000000000) &&
        isValidOptionalInt('unitCostPaise', 0, 1000000000000) &&
        isValidOptionalInt('unitPurchasePricePaise', 0, 1000000000000) &&
        isValidOptionalInt('unitPricePaise', 0, 1000000000000) &&
        isValidOptionalInt('unitSellPaise', 0, 1000000000000) &&
        isValidOptionalInt('unitSellingPricePaise', 0, 1000000000000) &&
        isValidOptionalInt('discountPaise', 0, 1000000000000) &&
        isValidOptionalInt('gstRateBps', 0, 5000) &&
        isValidOptionalNumber('taxRatePercent', 0, 100) &&
        isValidOptionalNumber('taxRate', 0, 100) &&
        isValidOptionalInt('taxPaise', 0, 1000000000000) &&
        isValidOptionalInt('lineTaxPaise', 0, 1000000000000) &&
        isValidOptionalInt('lineCostPaise', 0, 1000000000000) &&
        isValidOptionalInt('lineTotalPaise', 0, 1000000000000) &&
        isValidOptionalInt('lineProfitPaise', -1000000000000, 1000000000000) &&
        isValidOptionalBool('isReturned') &&
        isValidOptionalBool('isDeleted') &&
        isValidOptionalString('createdBy', 0, 128) &&
        isValidOptionalString('createdByUid', 0, 128) &&
        isValidOptionalString('updatedBy', 0, 128) &&
        isValidOptionalString('updatedByUid', 0, 128) &&
        isValidOptionalTimestampOrEpoch('createdAt') &&
        isValidOptionalTimestampOrEpoch('updatedAt');
    }

    function isValidInvoiceLineCreate(shopId, lineId) {
      return isValidInvoiceLineFields(shopId, lineId);
    }

    function isValidInvoiceLineUpdate(shopId, lineId) {
      return isValidInvoiceLineFields(shopId, lineId) &&
        areImmutableFieldsUnchanged(['invoiceId']) &&
        isImmutableIfPresent('id') &&
        isValidShopIdUpdateTransition(shopId) &&
        isImmutableIfPresent('createdBy') &&
        isImmutableIfPresent('createdByUid') &&
        isImmutableIfPresent('createdAt');
    }

    // --- 12. /shops/{shopId}/party_ledger/{entryId} (PartyTransactionEntity) ---
    function isValidPartyLedgerFields(shopId, entryId) {
      return hasRequiredFields(['partyId']) &&
        (
          ('amountPaise' in request.resource.data) ||
          ('amountDeltaPaise' in request.resource.data)
        ) &&
        hasOnlyAllowedFields([
          'id', 'entryId', 'shopId', 'partyId', 'invoiceId', 'refDocId',
          'entryType', 'type', 'direction',
          'amountPaise', 'amountDeltaPaise', 'balanceAfterPaise',
          'paymentMode', 'paymentMethod', 'referenceNo', 'referenceId',
          'note', 'notes', 'description', 'occurredAt', 'isDeleted',
          'createdBy', 'createdByUid', 'updatedBy', 'updatedByUid',
          'createdAt', 'updatedAt'
        ]) &&
        isValidOptionalIdMatch('id', entryId) &&
        isValidOptionalIdMatch('entryId', entryId) &&
        isValidOptionalShopIdField(shopId) &&
        validStringLength('partyId', 1, 128) &&
        isValidOptionalString('invoiceId', 0, 128) &&
        isValidOptionalString('refDocId', 0, 128) &&
        (
          !('entryType' in request.resource.data) ||
          (request.resource.data.entryType is string &&
            request.resource.data.entryType in [
              'CREDIT_BILL', 'JAMA_CASH', 'JAMA_UPI', 'SUPP_PURCHASE', 'SUPP_PAY',
              'DEBIT', 'CREDIT', 'PAYMENT_IN', 'PAYMENT_OUT',
              'INVOICE', 'RETURN', 'ADJUSTMENT', 'OPENING',
              'credit_bill', 'jama_cash', 'jama_upi', 'supp_purchase', 'supp_pay',
              'debit', 'credit', 'payment_in', 'payment_out',
              'invoice', 'return', 'adjustment', 'opening'
            ])
        ) &&
        (
          !('type' in request.resource.data) ||
          (request.resource.data.type is string &&
            request.resource.data.type in [
              'CREDIT_BILL', 'JAMA_CASH', 'JAMA_UPI', 'SUPP_PURCHASE', 'SUPP_PAY',
              'DEBIT', 'CREDIT', 'PAYMENT_IN', 'PAYMENT_OUT',
              'INVOICE', 'RETURN', 'ADJUSTMENT', 'OPENING',
              'credit_bill', 'jama_cash', 'jama_upi', 'supp_purchase', 'supp_pay',
              'debit', 'credit', 'payment_in', 'payment_out',
              'invoice', 'return', 'adjustment', 'opening'
            ])
        ) &&
        (
          !('direction' in request.resource.data) ||
          (request.resource.data.direction is string &&
            request.resource.data.direction in ['DEBIT', 'CREDIT', 'debit', 'credit'])
        ) &&
        isValidOptionalInt('amountPaise', -1000000000000, 1000000000000) &&
        isValidOptionalInt('amountDeltaPaise', -1000000000000, 1000000000000) &&
        isValidOptionalInt('balanceAfterPaise', -1000000000000, 1000000000000) &&
        isValidOptionalString('paymentMode', 0, 40) &&
        isValidOptionalString('paymentMethod', 0, 40) &&
        isValidOptionalString('referenceNo', 0, 80) &&
        isValidOptionalString('referenceId', 0, 128) &&
        isValidOptionalString('note', 0, 500) &&
        isValidOptionalString('notes', 0, 500) &&
        isValidOptionalString('description', 0, 500) &&
        isValidOptionalTimestampOrEpoch('occurredAt') &&
        isValidOptionalBool('isDeleted') &&
        isValidOptionalString('createdBy', 0, 128) &&
        isValidOptionalString('createdByUid', 0, 128) &&
        isValidOptionalString('updatedBy', 0, 128) &&
        isValidOptionalString('updatedByUid', 0, 128) &&
        isValidOptionalTimestampOrEpoch('createdAt') &&
        isValidOptionalTimestampOrEpoch('updatedAt');
    }

    function isValidPartyLedgerCreate(shopId, entryId) {
      return isValidPartyLedgerFields(shopId, entryId);
    }

    function isValidPartyLedgerUpdate(shopId, entryId) {
      return isValidPartyLedgerFields(shopId, entryId) &&
        areImmutableFieldsUnchanged(['partyId']) &&
        isImmutableIfPresent('id') &&
        isImmutableIfPresent('entryId') &&
        isValidShopIdUpdateTransition(shopId) &&
        isImmutableIfPresent('invoiceId') &&
        isImmutableIfPresent('refDocId') &&
        isImmutableIfPresent('occurredAt') &&
        isImmutableIfPresent('createdBy') &&
        isImmutableIfPresent('createdByUid') &&
        isImmutableIfPresent('createdAt');
    }

    // --- 13. /shops/{shopId}/stock_movements/{movementId} (StockMovementEntity, Immutable Append-Only) ---
    function isValidStockMovementCreate(shopId, movementId) {
      return hasOnlyAllowedFields([
          'id', 'movementId', 'shopId', 'productId', 'skuId', 'itemId', 'variantId',
          'deviceShortCode', 'deltaMilliUnits', 'deltaQty', 'quantityDelta',
          'delta', 'quantity', 'balanceAfter', 'stockAfter',
          'movementType', 'type', 'reason',
          'referenceType', 'referenceId', 'refDocId', 'invoiceId',
          'note', 'notes', 'occurredAt',
          'createdBy', 'createdByUid', 'actorUid', 'createdAt'
        ]) &&
        (
          validStringLength('skuId', 1, 128) ||
          validStringLength('variantId', 1, 128) ||
          validStringLength('productId', 1, 128) ||
          validStringLength('itemId', 1, 128)
        ) &&
        (
          ('deltaMilliUnits' in request.resource.data) ||
          ('deltaQty' in request.resource.data) ||
          ('quantityDelta' in request.resource.data)
        ) &&
        isValidOptionalIdMatch('id', movementId) &&
        isValidOptionalIdMatch('movementId', movementId) &&
        isValidOptionalShopIdField(shopId) &&
        isValidOptionalString('productId', 1, 128) &&
        isValidOptionalString('skuId', 1, 128) &&
        isValidOptionalString('itemId', 1, 128) &&
        isValidOptionalString('variantId', 1, 128) &&
        isValidOptionalString('deviceShortCode', 0, 32) &&
        isValidOptionalInt('deltaMilliUnits', -100000000000, 100000000000) &&
        isValidOptionalNumber('deltaQty', -100000000, 100000000) &&
        isValidOptionalNumber('quantityDelta', -100000000, 100000000) &&
        isValidOptionalNumber('delta', -100000000, 100000000) &&
        isValidOptionalNumber('quantity', -100000000, 100000000) &&
        isValidOptionalNumber('balanceAfter', 0, 100000000) &&
        isValidOptionalNumber('stockAfter', 0, 100000000) &&
        (
          !('movementType' in request.resource.data) ||
          (request.resource.data.movementType is string &&
            request.resource.data.movementType in [
              'SALE', 'SALE_RETURN', 'RETURN', 'PURCHASE', 'RESTOCK',
              'ADJUSTMENT', 'OPENING', 'DAMAGE', 'LOSS', 'TRANSFER', 'INITIAL',
              'sale', 'sale_return', 'return', 'purchase', 'restock',
              'adjustment', 'opening', 'damage', 'loss', 'transfer', 'initial'
            ])
        ) &&
        (
          !('type' in request.resource.data) ||
          (request.resource.data.type is string &&
            request.resource.data.type in [
              'SALE', 'SALE_RETURN', 'RETURN', 'PURCHASE', 'RESTOCK',
              'ADJUSTMENT', 'OPENING', 'DAMAGE', 'LOSS', 'TRANSFER', 'INITIAL',
              'sale', 'sale_return', 'return', 'purchase', 'restock',
              'adjustment', 'opening', 'damage', 'loss', 'transfer', 'initial'
            ])
        ) &&
        isValidOptionalString('reason', 0, 100) &&
        isValidOptionalString('referenceType', 0, 40) &&
        isValidOptionalString('referenceId', 0, 128) &&
        isValidOptionalString('refDocId', 0, 128) &&
        isValidOptionalString('invoiceId', 0, 128) &&
        isValidOptionalString('note', 0, 500) &&
        isValidOptionalString('notes', 0, 500) &&
        isValidOptionalTimestampOrEpoch('occurredAt') &&
        isValidOptionalString('createdBy', 0, 128) &&
        isValidOptionalString('createdByUid', 0, 128) &&
        isValidOptionalString('actorUid', 0, 128) &&
        isValidOptionalTimestampOrEpoch('createdAt');
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profile documents: strict per-user PII isolation
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && isValidUserCreate(uid);
      allow update: if isOwner(uid) && isValidUserUpdate(uid);
      allow delete: if isOwner(uid);
    }

    // Multi-tenant Shops collection
    match /shops/{shopId} {
      allow get: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      allow list: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuthenticated() && isValidShopCreate(shopId);
      allow update: if (isShopOwner(shopId) || isResourceShopOwner()) && isValidShopUpdate(shopId);
      allow delete: if isShopOwner(shopId) || isResourceShopOwner();

      // Shop role-based membership documents (/shops/{shopId}/members/{memberUid})
      match /members/{memberUid} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId) || isOwner(memberUid);
        allow create: if isAuthenticated() &&
          isValidMemberCreate(shopId, memberUid) &&
          (
            isShopOwner(shopId) ||
            isShopOwnerDoc(shopId) ||
            (request.auth.uid == memberUid && isShopOwnerDocAfter(shopId))
          );
        allow update: if isAuthenticated() &&
          (isShopOwner(shopId) || isShopOwnerDoc(shopId)) &&
          isValidMemberUpdate(shopId, memberUid);
        allow delete: if isAuthenticated() &&
          (isShopOwner(shopId) || isShopOwnerDoc(shopId));
      }

      // v1 Room-synced inventory items
      match /items/{itemId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidItemCreate(shopId, itemId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidItemUpdate(shopId, itemId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v1 Room-synced item variants
      match /variants/{variantId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidVariantCreate(shopId, variantId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidVariantUpdate(shopId, variantId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v1 Room-synced sale records
      match /sales/{saleId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidSaleCreate(shopId, saleId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidSaleUpdate(shopId, saleId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant catalog products
      match /products/{productId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidProductCreate(shopId, productId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidProductUpdate(shopId, productId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant SKUs
      match /skus/{skuId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidSkuCreate(shopId, skuId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidSkuUpdate(shopId, skuId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant customers & suppliers
      match /parties/{partyId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidPartyCreate(shopId, partyId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidPartyUpdate(shopId, partyId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant invoices
      match /invoices/{invoiceId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidInvoiceCreate(shopId, invoiceId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidInvoiceUpdate(shopId, invoiceId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant invoice line items
      match /invoice_lines/{lineId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidInvoiceLineCreate(shopId, lineId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidInvoiceLineUpdate(shopId, lineId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Multi-tenant party khata ledger
      match /party_ledger/{entryId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidPartyLedgerCreate(shopId, entryId);
        allow update: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidPartyLedgerUpdate(shopId, entryId);
        allow delete: if isShopMember(shopId) || isShopOwnerDoc(shopId);
      }

      // v2 Immutable append-only stock movement log
      match /stock_movements/{movementId} {
        allow read: if isShopMember(shopId) || isShopOwnerDoc(shopId);
        allow create: if (isShopMember(shopId) || isShopOwnerDoc(shopId)) && isValidStockMovementCreate(shopId, movementId);
        allow update, delete: if false;
      }
    }
  }
}
